# ===========================================================
# Kopiera till server/.env och fyll i. FILEN SKA INTE IN I GIT.
# ===========================================================

# --- GitHub ---
GITHUB_OWNER=Tommymil46
GITHUB_REPO=pf1920friidrott
GITHUB_BRANCH=main
# Fine-grained personal access token med Contents: Read and write
# på just detta repo. Skapas på https://github.com/settings/tokens?type=beta
GITHUB_TOKEN=KLISTRA_IN_DIN_TOKEN_HAR

# --- Säkerhet ---
# Skapa med:  openssl rand -hex 32
JWT_SECRET=KOR_openssl_rand_hex_32_OCH_KLISTRA_IN_HAR
TOKEN_TIMMAR=12

# Sätt till 1 ENDAST när tjänsten står bakom en omvänd proxy och porten är
# bunden till 127.0.0.1. Annars kan spärren mot lösenordsgissning kringgås.
TRUST_PROXY=0

# Tillåtna webbadresser som får anropa API:t (kommaseparerat).
# Sätt till adressen där GitHub Pages publicerar sidan.
ALLOWED_ORIGINS=https://tommymil46.github.io

# --- Ledare ---
# Startlösenord = samma som namnet. Byts i webbappen under "Byt lösenord".
LEDARE=Anna,Eric,Johan,Ludvig,tommy

# Under uppbyggnaden: 0 (standard) så ledarna kan redigera med kontonamnet
# som lösenord, t.ex. anna/anna. Sätt till 1 när sidan går i skarp drift –
# då krävs ett riktigt lösenord innan något går att ändra. Se docs/SAKERHET.md.
KRAV_LOSENORDSBYTE=0

# --- Övrigt ---
PORT=8080
# Hur länge publika läsningar cachas i minnet (ms). Skyddar GitHub-tokenens
# anropsbudget om någon laddar om sidan i loop.
LAS_CACHE_MS=20000
MAX_FIL_MB=10
MAX_SIDOR=3
KLUBB=Hagunda IF · Friidrott
CONTENT_BASE=content
UPLOAD_PATH=content/uploads
