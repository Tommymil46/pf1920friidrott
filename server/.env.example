# ===========================================================
# Kopiera till server/.env och fyll i. FILEN SKA INTE IN I GIT.
# ===========================================================

# --- GitHub ---
GITHUB_OWNER=Tommymil46
GITHUB_REPO=pf1920friidrott
GITHUB_BRANCH=main
# Fine-grained personal access token med Contents: Read and write
# på just detta repo. Skapas på https://github.com/settings/tokens?type=beta
GITHUB_TOKEN=ghp_byt_ut_mig

# --- Säkerhet ---
# Skapa med:  openssl rand -hex 32
JWT_SECRET=byt_ut_mig_till_en_lang_slumpstrang
TOKEN_TIMMAR=12

# Tillåtna webbadresser som får anropa API:t (kommaseparerat).
# Sätt till adressen där GitHub Pages publicerar sidan.
ALLOWED_ORIGINS=https://tommymil46.github.io

# --- Ledare ---
# Startlösenord = samma som namnet. Byts i webbappen under "Byt lösenord".
LEDARE=Anna,Eric,Johan,Ludvig,tommy

# --- Övrigt ---
PORT=8080
MAX_FIL_MB=10
MAX_SIDOR=3
KLUBB=Hagunda IF · Friidrott
CONTENT_PATH=content/pass.json
UPLOAD_PATH=content/uploads
